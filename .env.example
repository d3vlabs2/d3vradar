RADAR_AUTH_MODE=cloudflare
RADAR_ORIGIN=https://radar.example.com
CF_ACCESS_TEAM=your-team.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-access-application-audience
RADAR_ALLOWED_EMAILS=you@example.com
RADAR_ENCRYPTION_KEY=generate-with-deploy-configure-py
RADAR_SCHEDULER=true
# Optional indexed discovery for required boards without a public feed:
BRAVE_SEARCH_API_KEY=

# Optional browser-visible Maps Embed API key; restrict to your Radar website and Maps Embed API.
GOOGLE_MAPS_EMBED_API_KEY=
